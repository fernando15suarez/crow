TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
TELEGRAM_CHAT_ID=your-chat-id
TELEGRAM_CHAT_IDS=your-chat-id
TELEGRAM_ADMIN_ID=your-chat-id

# Gas Town integration (optional).
# If unset, Crow auto-detects ~/gt. Set this if Gas Town lives elsewhere,
# or leave unset if Gas Town isn't installed (Crow will run as a plain
# Telegram bot without mail/nudge/event features).
# GT_ROOT=/home/youruser/gt

# tmux session name for the mayor's Claude Code process (used by /sigint).
# Gas Town typically names this <town-prefix>-mayor (e.g. "hq-mayor").
# Defaults to "mayor" if unset.
# MAYOR_TMUX_SESSION=hq-mayor
